{
  "name": "clan-hub-crea-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "desktop": "npm run build && electron . --ozone-platform=x11",
    "package:backend": "pyinstaller --noconfirm --clean --onedir --name clan-hub-backend --distpath build/backend --workpath build/pyinstaller server.py",
    "package:rpm": "npm run security:check && npm run build && npm run package:backend && electron-builder --linux rpm && npm run security:release",
    "test": "node --test tests/*.test.cjs",
    "security:check": "python3 scripts/security_check.py",
    "security:release": "python3 scripts/security_check.py --release release/linux-unpacked"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "org.clanhub.creamanager",
    "productName": "Clan Hub Crea Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "communications",
        "to": "discord-worker/communications",
        "filter": [
          "**/*.py",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "requirements-discord-self.txt",
        "to": "discord-worker/requirements-discord-self.txt"
      },
      {
        "from": "build/backend/clan-hub-backend",
        "to": "backend"
      },
      {
        "from": "assets/fonts",
        "to": "assets/fonts"
      },
      {
        "from": "public/icons",
        "to": "public/icons"
      }
    ],
    "linux": {
      "target": [
        "rpm"
      ],
      "category": "Graphics",
      "icon": "public/icons/icon-512.png",
      "syncDesktopName": true,
      "executableArgs": [
        "--ozone-platform=x11"
      ]
    }
  },
  "homepage": "http://localhost/",
  "author": "Clan Hub <clan-hub@localhost>",
  "description": "Local crea gallery and staging manager",
  "desktopName": "clan-hub-crea-manager",
  "overrides": {
    "@electron/universal": {
      "minimatch": "11.0.9"
    },
    "app-builder-lib": {
      "minimatch": "11.0.9"
    }
  }
}
